pipeline{
    agent any
    environment{
        BUILD_NUMBER = '1.0.0'
    }
    stages{
        stage('Build'){
            steps{
                echo 'Building the project'
            }
        }
        stage('Test'){
            steps{
                echo 'Testing the project'
            }
        }
        stage('Deploy'){
            steps{
                echo 'Deploying the project'
            }
        }
        stage('Python Version'){
            steps{
                // check python version
                sh 'docker-compose exec web python --version'
            }
        }
        stage('Schedule Python Task'){
            steps{
                // run test_python file from Advanced_Python folder
                sh 'python3 test_python.py'
            }
        }
        
    }
}